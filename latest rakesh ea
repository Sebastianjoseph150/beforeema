//| Detects the 4-Candle Reversal Pattern (3 bullish + 1 bearish OR  |
//| 3 bearish + 1 bullish) with Dynamic Reset                        |
//+------------------------------------------------------------------+
CandleData patternArray[4];
int patternCount = 0;

void ResetPattern(const CandleData &startCandle)
{
   patternArray[0] = startCandle;
   patternCount = 1;
   PrintFormat("🔄 Pattern reset → starting from new candle at %s", TimeToString(startCandle.time));
}
void CheckSpecialPattern(const CandleData &c)
{
   // Step 1️⃣: Start new pattern
   if (patternCount == 0)
   {
      patternArray[0] = c;
      patternCount = 1;
      PrintFormat("condition3 🟢 Starting new pattern at candle %s", TimeToString(c.time));
      return;
   }

   CandleData last = patternArray[patternCount - 1];

   // Step 2️⃣: Continue 2nd & 3rd candle (same direction only)
   if (patternCount == 1 || patternCount == 2)
   {
      if (c.isBullish == last.isBullish)
      {
         patternArray[patternCount] = c;
         patternCount++;
         PrintFormat("condition3 ✅ Candle %d continues pattern | Type=%s",
                     patternCount, c.isBullish ? "Bullish" : "Bearish");
      }
      else
      {
         Print("condition3 ❌ Candle type mismatch → Resetting pattern");
         ResetPattern(c);
      }
      return;
   }

   // Step 3️⃣: Check 4th candle for reversal engulf
   else if (patternCount == 3)
   {
      CandleData c3 = patternArray[2];
      bool engulf = false;

      // --- 🔻 Bearish reversal ---
      if (c3.isBullish && !c.isBullish)
      {
         // Bearish candle’s *body* (open-close range) covers full c3 (body + wick)
         double bearBodyTop = MathMax(c.open, c.close);
         double bearBodyBottom = MathMin(c.open, c.close);

         engulf = (bearBodyTop >= c3.high && bearBodyBottom <= c3.low);

         if (engulf)
         {
            Print("condition3 📉 Bearish BODY Engulfs full previous candle (body+wick) → SELL");
            double lot = 0.02;
            double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            double sl = c3.high;
            double tp = price - (sl - price) * RiskRewardRatio;

            if (!trade.Sell(lot, _Symbol, price, sl, tp, "BearishBodyEngulf"))
               PrintFormat("❌ SELL failed: %d", GetLastError());
            else
               PrintFormat("✅ SELL placed | Entry=%.5f SL=%.5f TP=%.5f", price, sl, tp);

            ResetPattern(c);
            return;
         }
      }

      // --- 🔺 Bullish reversal ---
      else if (!c3.isBullish && c.isBullish)
      {
         // Bullish candle’s *body* covers full previous candle (body+wick)
         double bullBodyTop = MathMax(c.open, c.close);
         double bullBodyBottom = MathMin(c.open, c.close);

         engulf = (bullBodyTop >= c3.high && bullBodyBottom <= c3.low);

         if (engulf)
         {
            Print("condition3 📈 Bullish BODY Engulfs full previous candle (body+wick) → BUY");
            double lot = 0.02;
            double price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            double sl = c3.low;
            double tp = price + (price - sl) * RiskRewardRatio;

            if (!trade.Buy(lot, _Symbol, price, sl, tp, "BullishBodyEngulf"))
               PrintFormat("❌ BUY failed: %d", GetLastError());
            else
               PrintFormat("✅ BUY placed | Entry=%.5f SL=%.5f TP=%.5f", price, sl, tp);

            ResetPattern(c);
            return;
         }
      }

      // --- Same direction → shift pattern (continue trend)
      if (!engulf && c.isBullish == c3.isBullish)
      {
         patternArray[0] = patternArray[1];
         patternArray[1] = patternArray[2];
         patternArray[2] = c;
         Print("condition3 🔁 Same direction continuation → Shift pattern forward");
         return;
      }

      // --- No engulf → reset pattern
      Print("condition3 ❌ 4th candle failed full body engulf → Resetting pattern");
      ResetPattern(c);
      return;
   }
}


