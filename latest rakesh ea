bool IsConsolidationZone(int barsBack=15)
{
   double highest = iHigh(_Symbol, PERIOD_M1, iHighest(_Symbol, PERIOD_M1, MODE_HIGH, barsBack, 1));
   double lowest  = iLow(_Symbol, PERIOD_M1, iLowest(_Symbol, PERIOD_M1, MODE_LOW, barsBack, 1));
   double range = highest - lowest;

   double avgBody = 0;
   for(int i=1; i<=barsBack; i++)
   {
      double open  = iOpen(_Symbol, PERIOD_M1, i);
      double close = iClose(_Symbol, PERIOD_M1, i);
      avgBody += MathAbs(close - open);
   }
   avgBody /= barsBack;

   // Conditions: small overall range + small average candle body
   if(range < avgBody * 4)
      return true;
   else
      return false;
}
//+------------------------------------------------------------------+
//|  Returns the all-time high and low for the current symbol        |
//+------------------------------------------------------------------+
void GetAllTimePriceRange(string symbol, ENUM_TIMEFRAMES timeframe,
                          double &allTimeHigh, double &allTimeLow)
{
   int totalBars = Bars(symbol, timeframe);
   if (totalBars <= 0)
   {
      PrintFormat("⚠️ No bars found for %s on timeframe %d", symbol, timeframe);
      allTimeHigh = 0;
      allTimeLow  = 0;
      return;
   }

   // Initialize with extreme values
   allTimeHigh = -DBL_MAX;
   allTimeLow  = DBL_MAX;

   // Loop through all bars on the chart
   for (int i = 0; i < totalBars; i++)
   {
      double high = iHigh(symbol, timeframe, i);
      double low  = iLow(symbol, timeframe, i);

      if (high > allTimeHigh)
         allTimeHigh = high;
      if (low < allTimeLow)
         allTimeLow = low;
   }

   PrintFormat("📈 All-Time Range for %s (%s): High=%.2f | Low=%.2f",
               symbol, EnumToString(timeframe), allTimeHigh, allTimeLow);
} 

