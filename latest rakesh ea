////////////////////////////////////////////////////////////////////////fvg
bool IsNearbyFVG(string symbol, string direction)
{
   ENUM_TIMEFRAMES tf = (ENUM_TIMEFRAMES)ChartPeriod(0);
   int lookback = 100;
   double point = SymbolInfoDouble(symbol, SYMBOL_POINT);
   double minGap = 5 * point;           // Minimum 5-point gap
   double distanceThreshold = 2 * point; // Allow small distance for "nearby"

   for (int i = 2; i < lookback; i++)
   {
      double high1 = iHigh(symbol, tf, i);
      double low1  = iLow(symbol, tf, i);
      double high3 = iHigh(symbol, tf, i + 2);
      double low3  = iLow(symbol, tf, i + 2);

      // --- Bullish FVG (low1 > high3) ---
      if (low1 - high3 >= minGap && direction == "BUY")
      {
         double gapTop = low1;
         double gapBottom = high3;
         double current = SymbolInfoDouble(symbol, SYMBOL_BID);

         // Price must be inside or close to the FVG
         if (current >= gapBottom - distanceThreshold && current <= gapTop + distanceThreshold)
         {
            // Check if mitigated (touched by later candles)
            bool mitigated = false;
            for (int j = i - 1; j >= 1; j--)
            {
               double prevHigh = iHigh(symbol, tf, j);
               double prevLow  = iLow(symbol, tf, j);
               if (prevLow <= gapTop && prevHigh >= gapBottom)
               {
                  mitigated = true;
                  break;
               }
            }

            if (mitigated)
            {
               PrintFormat("✅ Bullish FVG found (%.2f–%.2f, gap=%.1f pts)", gapBottom, gapTop, (low1 - high3) / point);
               return true;
            }
         }
      }

      // --- Bearish FVG (high1 < low3) ---
      if (low3 - high1 >= minGap && direction == "SELL")
      {
         double gapTop = low3;
         double gapBottom = high1;
         double current = SymbolInfoDouble(symbol, SYMBOL_ASK);

         if (current <= gapTop + distanceThreshold && current >= gapBottom - distanceThreshold)
         {
            bool mitigated = false;
            for (int j = i - 1; j >= 1; j--)
            {
               double prevHigh = iHigh(symbol, tf, j);
               double prevLow  = iLow(symbol, tf, j);
               if (prevLow <= gapTop && prevHigh >= gapBottom)
               {
                  mitigated = true;
                  break;
               }
            }

            if (mitigated)
            {
               PrintFormat("✅ Bearish FVG found (%.2f–%.2f, gap=%.1f pts)", gapBottom, gapTop, (low3 - high1) / point);
               return true;
            }
         }
      }
   }

   PrintFormat("🚫 No valid FVG (≥5 pts) found for %s direction", direction);
   return false;
}
