//+------------------------------------------------------------------+
void tradeBuy(string symbol, double lot)
{
 // 🔍 Check if there's already an open BUY trade for this symbol
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      string posSymbol = PositionGetSymbol(i);
      if (posSymbol == symbol)
      {
         if (PositionSelect(symbol))
         {
            long posType = PositionGetInteger(POSITION_TYPE);
            if (posType == POSITION_TYPE_BUY)
            {
               Print("⚠️ Existing BUY position found on ", symbol, " — skipping new trade.");
               return; // ❌ Exit without opening another trade
            }
         }
      }
   }
   double price = SymbolInfoDouble(symbol, SYMBOL_ASK);
   double sl = NormalizeDouble(price - initialSLPoints * _Point, _Digits);
   double tp = NormalizeDouble(price + (initialSLPoints * RiskRewardRatio) * _Point, _Digits);

   MqlTradeRequest request;
   MqlTradeResult result;
   ZeroMemory(request); ZeroMemory(result);

   request.action    = TRADE_ACTION_DEAL;
   request.symbol    = symbol;
   request.volume    = lot;
   request.type      = ORDER_TYPE_BUY;
   request.price     = price;
   request.sl        = sl;   // <---- ✅ Set SL
   request.tp        = tp;   // <---- ✅ Set TP
   request.comment   = "CandleTrackerBuy";

   if(!OrderSend(request, result))
      Print("❌ BUY OrderSend failed: ", GetLastError());
   else
      Print("✅ BUY Order opened at ", price, " SL=", sl, " TP=", tp);
}


