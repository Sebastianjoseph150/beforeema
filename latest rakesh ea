//| Detects the 4-Candle Reversal Pattern (3 bullish + 1 bearish OR  |
//| 3 bearish + 1 bullish) with Dynamic Reset                        |
//+------------------------------------------------------------------+
CandleData patternArray[4];
int patternCount = 0;

void ResetPattern(const CandleData &startCandle)
{
   patternArray[0] = startCandle;
   patternCount = 1;
   PrintFormat("🔄 Pattern reset → starting from new candle at %s", TimeToString(startCandle.time));
}

void CheckSpecialPattern(const CandleData &c)
{
   // Step 1️⃣: Add first candle
   if (patternCount == 0)
   {
      patternArray[0] = c;
      patternCount = 1;
      PrintFormat("🟢 Starting new pattern at candle time %s", TimeToString(c.time));
      return;
   }

   CandleData last = patternArray[patternCount - 1];

   // Step 2️⃣: Handle 2nd and 3rd candle (same direction continuation)
   if (patternCount == 1 || patternCount == 2)
   {
      if (c.isBullish == last.isBullish)
      {
         double prevBodyTop    = MathMax(last.open, last.close);
         double prevBodyBottom = MathMin(last.open, last.close);

         bool valid = false;

         if (c.isBullish)
         {
            // For bullish continuation → low must be at least 75% above previous body top
            double tolerance = prevBodyTop + (MathAbs(last.close - last.open) * 0.25);
            valid = (c.low > tolerance);
         }
         else
         {
            // For bearish continuation → high must be at least 75% below previous body bottom
            double tolerance = prevBodyBottom - (MathAbs(last.close - last.open) * 0.25);
            valid = (c.high < tolerance);
         }

         if (valid)
         {
            patternArray[patternCount] = c;
            patternCount++;
            PrintFormat("✅ Candle %d continues pattern | Type=%s | Low=%.2f | High=%.2f",
                        patternCount, c.isBullish ? "Bullish" : "Bearish", c.low, c.high);
         }
         else
         {
            PrintFormat("❌ Candle %d overlaps previous candle body → Resetting pattern",
                        patternCount + 1);
            ResetPattern(c);
            return;
         }
      }
      else
      {
         Print("❌ Candle type mismatch → Resetting pattern");
         ResetPattern(c);
         return;
      }
   }

   // Step 3️⃣: Check 4th candle (engulfing rule)
   else if (patternCount == 3)
   {
      CandleData c3 = patternArray[2];
      double bodyTop3 = MathMax(c3.open, c3.close);
      double bodyBottom3 = MathMin(c3.open, c3.close);
      bool engulf = false;

      // --- Bearish Engulfing ---
      if (c3.isBullish && !c.isBullish)
      {
         // Allow 75% engulf instead of 100%
         double engulfTolerance = bodyBottom3 + (bodyTop3 - bodyBottom3) * 0.25;
         engulf = (c.open > bodyTop3 && c.close < engulfTolerance);

         if (engulf)
         {
            Print("📉 Bearish Engulfing detected → Opening SELL");
            double lot = 0.02;
            double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            double sl = c3.high;
            double tp = price - (sl - price) * RiskRewardRatio;
            trade.Sell(lot, _Symbol, price);
            ResetPattern(c);
            return;
         }
      }

      // --- Bullish Engulfing ---
      else if (!c3.isBullish && c.isBullish)
      {
         double engulfTolerance = bodyTop3 - (bodyTop3 - bodyBottom3) * 0.25;
         engulf = (c.open < bodyBottom3 && c.close > engulfTolerance);

         if (engulf)
         {
            Print("📈 Bullish Engulfing detected → Opening BUY");
            double lot = 0.02;
            double price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            double sl = c3.low;
            double tp = price + (price - sl) * RiskRewardRatio;
            trade.Buy(lot, _Symbol, price);
            ResetPattern(c);
            return;
         }
      }

      // No engulf → reset pattern
      Print("❌ 4th candle failed to engulf → Resetting pattern");
      ResetPattern(c);
      return;
   }
}

