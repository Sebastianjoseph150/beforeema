bool IsConsolidationZone(int barsBack=15)
{
   double highest = iHigh(_Symbol, PERIOD_M5, iHighest(_Symbol, PERIOD_M5, MODE_HIGH, barsBack, 1));
   double lowest  = iLow(_Symbol, PERIOD_M5, iLowest(_Symbol, PERIOD_M5, MODE_LOW, barsBack, 1));
   double range = highest - lowest;

   double avgBody = 0;
   for(int i=1; i<=barsBack; i++)
   {
      double open  = iOpen(_Symbol, PERIOD_M5, i);
      double close = iClose(_Symbol, PERIOD_M5, i);
      avgBody += MathAbs(close - open);
   }
   avgBody /= barsBack;

   // Conditions: small overall range + small average candle body
   if(range < avgBody * 4)
      return true;
   else
      return false;
}
