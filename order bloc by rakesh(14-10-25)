//| Detects the 4-Candle Reversal Pattern (3 bullish + 1 bearish OR  |
//| 3 bearish + 1 bullish) with Dynamic Reset                        |
//+------------------------------------------------------------------+
CandleData patternArray[4];
int patternCount = 0;

void ResetPattern(const CandleData &startCandle)
{
   patternArray[0] = startCandle;
   patternCount = 1;
   PrintFormat("🔄 Pattern reset → starting from new candle at %s", TimeToString(startCandle.time));
}

void CheckSpecialPattern(const CandleData &c)
{
   // Step 1️⃣: Add new candle or reset if needed
   if (patternCount == 0)
   {
      patternArray[0] = c;
      patternCount = 1;
      PrintFormat("🔎 Starting new pattern with candle %s", TimeToString(c.time));
      return;
   }

   CandleData last = patternArray[patternCount - 1];

   // Step 2️⃣: Type consistency logic
   if (patternCount == 1)
   {
      // Wait for second candle — must be same type
      if (c.isBullish == last.isBullish)
      {
         patternArray[1] = c;
         patternCount = 2;
         Print("✅ Second candle matches type → continuing pattern...");
      }
      else
      {
         Print("❌ Candle 2 type mismatch → resetting pattern");
         ResetPattern(c);
         return;
      }
   }
   else if (patternCount == 2)
   {
      // Wait for third candle — must also be same type
      if (c.isBullish == last.isBullish)
      {
         patternArray[2] = c;
         patternCount = 3;
         Print("✅ Third candle matches type → continuing pattern...");
      }
      else
      {
         Print("❌ Candle 3 type mismatch → resetting pattern");
         ResetPattern(c);
         return;
      }
   }
   else if (patternCount == 3)
   {
      // Fourth candle must be opposite type
      if (c.isBullish != last.isBullish)
      {
         patternArray[3] = c;
         patternCount = 4;
         Print("✅ Fourth candle opposite → checking structure...");
      }
      else
      {
         Print("❌ Candle 4 type mismatch → resetting pattern");
         ResetPattern(c);
         return;
      }
   }

   // Step 3️⃣: Check full pattern when 4 candles collected
   if (patternCount == 4)
   {
      CandleData c1 = patternArray[0];
      CandleData c2 = patternArray[1];
      CandleData c3 = patternArray[2];
      CandleData c4 = patternArray[3];

      bool first3Bullish = c1.isBullish && c2.isBullish && c3.isBullish;
      bool fourthBearish = !c4.isBullish;
      bool first3Bearish = !c1.isBullish && !c2.isBullish && !c3.isBullish;
      bool fourthBullish = c4.isBullish;

      // ---- BEARISH PATTERN ----
      if (first3Bullish && fourthBearish)
      {
         double upperWick3 = c3.high - MathMax(c3.open, c3.close);
         double lowerWick3 = MathMin(c3.open, c3.close) - c3.low;
         double body3 = MathAbs(c3.close - c3.open);
         double low4Body = MathMin(c4.open, c4.close);

         bool cond2 = (c2.low > c1.high);
         bool cond3 = (c3.low > c2.high);
         bool cond3Wick = (upperWick3 > body3 && upperWick3 > lowerWick3);
         bool cond4 = (low4Body < c3.low);

         if (cond2 && cond3 && cond3Wick && cond4)
         {
            Print("📉 Bearish pattern detected → Opening SELL");
            double lot = 0.01;
            double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            double sl = c3.high;
            double tp = price - (sl - price) * RiskRewardRatio;
            trade.Sell(lot, _Symbol, price);
         }
         else
         {
            Print("❌ Bearish pattern invalid → resetting from current candle");
            ResetPattern(c);
            return;
         }
      }

      // ---- BULLISH PATTERN ----
      else if (first3Bearish && fourthBullish)
      {
         double lowerWick3 = MathMin(c3.open, c3.close) - c3.low;
         double upperWick3 = c3.high - MathMax(c3.open, c3.close);
         double body3 = MathAbs(c3.close - c3.open);
         double high4Body = MathMax(c4.open, c4.close);

         bool cond2 = (c2.high < c1.low);
         bool cond3 = (c3.high < c2.low);
         bool cond3Wick = (lowerWick3 > body3 && lowerWick3 > upperWick3);
         bool cond4 = (high4Body > c3.high);

         if (cond2 && cond3 && cond3Wick && cond4)
         {
            Print("📈 Bullish pattern detected → Opening BUY");
            double lot = 0.01;
            double price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            double sl = c3.low;
            double tp = price + (price - sl) * RiskRewardRatio;
            trade.Buy(lot, _Symbol, price);
         }
         else
         {
            Print("❌ Bullish pattern invalid → resetting from current candle");
            ResetPattern(c);
            return;
         }
      }

      // Reset pattern for next sequence
      Print("🔁 Pattern complete → Resetting for next detection");
      ResetPattern(c);
   }
