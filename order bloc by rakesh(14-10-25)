struct CandleData {
   double open;
   double close;
   double high;
   double low;
   datetime time;
   bool isBullish;
};

//--- Global Variables
CandleData candleArray[4];
int candleCount = 0;
datetime lastCandleTime = 0;
input double TrailingMultiplier = 1.0;   // 1.0 = normal, 1.5 = 50% more distance


input double RiskRewardRatio = 1.0;      // Take Profit = RRR × Risk
input double BreakEvenTrigger = 500;     // Move SL to BE after profit in points (e.g. 300 = 30 pips if 5-digit)
input double BreakEvenBuffer = 50; 
input int    trailingPoints = 15000;      // Trailing Stop distance (points)
input int    initialSLPoints= 20000;        // Add small profit buffer (e.g. 50 = 5 pips)

