//+------------------------------------------------------------------+
//| Global variables                                                 |
//+------------------------------------------------------------------+
datetime lastBarTime = 0;

//+------------------------------------------------------------------+
//| Candle properties including wick                                  |
//+------------------------------------------------------------------+
double CandleHigh(int idx)  { return iHigh(_Symbol, PERIOD_CURRENT, idx); }
double CandleLow(int idx)   { return iLow(_Symbol, PERIOD_CURRENT, idx); }
double CandleOpen(int idx)  { return iOpen(_Symbol, PERIOD_CURRENT, idx); }
double CandleClose(int idx) { return iClose(_Symbol, PERIOD_CURRENT, idx); }

// Bull/Bear detection based on candle body
bool IsBull(int idx) { return CandleClose(idx) > CandleOpen(idx); }
bool IsBear(int idx) { return CandleClose(idx) < CandleOpen(idx); }

// Engulfing including wick
bool CandleEngulfs(int idxA, int idxB) {
    return (CandleHigh(idxA) >= CandleHigh(idxB) && CandleLow(idxA) <= CandleLow(idxB));
}

// Combined high/low for two candles
double CombinedHigh(int idx1, int idx2) { return MathMax(CandleHigh(idx1), CandleHigh(idx2)); }
double CombinedLow(int idx1, int idx2)  { return MathMin(CandleLow(idx1), CandleLow(idx2)); }

//+------------------------------------------------------------------+
//| Expert initialization                                             |
//+------------------------------------------------------------------+
int OnInit() {
    lastBarTime = 0;
    return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Normalize lot respecting min/max/step                             |
//+------------------------------------------------------------------+
double NormalizeLot(double lots)
{
   double minLot=0.01, maxLot=1000.0, step=0.01, tmp=0.0;
   if(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN,tmp)) minLot = tmp;
   if(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX,tmp)) maxLot = tmp;
   if(SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP,tmp)) step = tmp;
   if(step<=0) step=0.01;
   double normalized = MathFloor(lots/step+0.0000001)*step;
   if(normalized < minLot) normalized = minLot;
   if(normalized > maxLot) normalized = maxLot;
   return normalized;
}

//+------------------------------------------------------------------+
//| Compute lot size from risk money and SL (in points)              |
//+------------------------------------------------------------------+
double LotFromRisk(double riskMoney, double sl_points)
{
   if(sl_points <= 0) return(NormalizeLot(FixedLots));
   double tick_value=0.0, tick_size=0.0, point=_Point;
   if(!SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE,tick_value)) tick_value = 0.0;
   if(!SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE,tick_size)) tick_size = point;
   double value_per_point = tick_size>0 ? tick_value / tick_size : 0.0;
   if(value_per_point <= 0.0) return NormalizeLot(FixedLots);
   double money_risk_per_lot = value_per_point * sl_points;
   if(money_risk_per_lot <= 0.0) return NormalizeLot(FixedLots);
   return NormalizeLot(riskMoney / money_risk_per_lot);
}

//+------------------------------------------------------------------+
//| Place market order helper                                         |
//+------------------------------------------------------------------+
bool PlaceOrder(bool isBuy, double lots, double sl_price, double tp_price)
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetTypeFilling(ORDER_FILLING_FOK);
   trade.SetDeviationInPoints(10);

   bool result=false;
   if(isBuy)
      result = trade.Buy(lots,NULL,0,sl_price,tp_price,NULL);
   else
      result = trade.Sell(lots,NULL,0,sl_price,tp_price,NULL);

   if(!result)
      if(VerboseLogging) Print("Order failed: ",trade.ResultRetcode(), " - ", trade.ResultRetcodeDescription());
   else
      if(VerboseLogging) Print("Order placed: ", isBuy ? "BUY":"SELL", " lots=", DoubleToString(lots,2),
                              " SL=",DoubleToString(sl_price,_Digits), " TP=",DoubleToString(tp_price,_Digits));

   return result;
}

