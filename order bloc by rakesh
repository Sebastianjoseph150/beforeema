//+------------------------------------------------------------------+
//| Apply ATR-based Trailing Stop                                   |
//+------------------------------------------------------------------+
void ApplyTrailingStop()
{
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      // get ticket and select by ticket (more reliable)
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) 
         continue;
      if(!PositionSelectByTicket(ticket))
         continue;

      string sym   = PositionGetString(POSITION_SYMBOL);
      long   type  = PositionGetInteger(POSITION_TYPE);
      double open  = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl    = PositionGetDouble(POSITION_SL);
      double tp    = PositionGetDouble(POSITION_TP);
      double price = (type == POSITION_TYPE_BUY)
                     ? SymbolInfoDouble(sym, SYMBOL_BID)
                     : SymbolInfoDouble(sym, SYMBOL_ASK);
      double profit = PositionGetDouble(POSITION_PROFIT);
      double volume = PositionGetDouble(POSITION_VOLUME);
      int    digits = (int)SymbolInfoInteger(sym, SYMBOL_DIGITS);

      // ===============================
      // Symbol-based trailing settings
      // ===============================
      double profitTrigger = 0.50;   // default
      double trailingGap   = 0.20;   // default

      if (StringFind(sym, "BTC") >= 0)  // for BTCUSD or BTC-related pairs
      {
         profitTrigger = 0.50;     // start trailing after +$1 profit
         trailingGap   = 0.20;     // keep SL $0.50 behind current price
      }
      else if (StringFind(sym, "XAU") >= 0) // for Gold pairs like XAUUSD
      {
         profitTrigger = 0.50;     // start trailing after +$0.50 profit
         trailingGap   = 0.20;     // keep SL $0.20 behind current price
      }

      // Only start trailing after reaching profit trigger
      if (profit < profitTrigger)
         continue;

      double newSL = 0.0;
      bool update = false;

      // BUY trade trailing logic
      if (type == POSITION_TYPE_BUY)
      {
         newSL = price - trailingGap;
         newSL = NormalizeDouble(newSL, digits);

         if (newSL > sl && newSL > open)
            update = true;
      }
      // SELL trade trailing logic
      else if (type == POSITION_TYPE_SELL)
      {
         newSL = price + trailingGap;
         newSL = NormalizeDouble(newSL, digits);

         if ((sl == 0.0 || newSL < sl) && newSL < open)
            update = true;
      }

      // Apply trailing stop modification
      if (update)
      {
         // modify by ticket rather than symbol to be extra safe
         MqlTradeRequest req;
         MqlTradeResult  res;
         ZeroMemory(req);
         ZeroMemory(res);

         req.action   = TRADE_ACTION_SLTP;
         req.position = ticket;
         req.sl       = newSL;
         req.tp       = tp;

         if(!OrderSend(req, res))
            PrintFormat("Failed to modify SL for ticket %I64u: Error %d", ticket, GetLastError());
         else
            PrintFormat("Trailing Stop updated for %s %s (%.2f lots): SL = %.*f, Profit = %.2f USD",
                        (type == POSITION_TYPE_BUY) ? "BUY" : "SELL",
                        sym, volume, digits, newSL, profit);
      }
   }
}


void SetInitialStopLoss()
{
   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      string sym = PositionGetSymbol(i);
      if(!PositionSelect(sym)) continue;

      long   type = PositionGetInteger(POSITION_TYPE);
      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl   = PositionGetDouble(POSITION_SL);
      double tp   = PositionGetDouble(POSITION_TP);

      // --- BUY ---
      if(type==POSITION_TYPE_BUY && sl==0.0)
      {
         double newSL = NormalizeDouble(open - initialSLPoints * _Point, _Digits);
         if(trade.PositionModify(sym,newSL,tp))
            Print("Initial SL set for BUY: ", DoubleToString(newSL,_Digits));
      }

      // --- SELL ---
      if(type==POSITION_TYPE_SELL && sl==0.0)
      {
         double newSL = NormalizeDouble(open + initialSLPoints * _Point, _Digits);
         if(trade.PositionModify(sym,newSL,tp))
            Print("Initial SL set for SELL: ", DoubleToString(newSL,_Digits));
      }
   }
}
// -------------------------------------
// 📍 Helper Function: Check if a candle is Doji
// -------------------------------------
bool IsDoji(double open, double close, double high, double low)
{
   double body = MathAbs(open - close);
   double range = high - low;
   if(range == 0) return true; // Avoid division by zero

   double bodyRatio = body / range;
   return (bodyRatio < 0.1);   // 10% or less of total range ⇒ Doji
}
