#property copyright "ChatGPT"
#property version   "1.60"
#property strict
#include <Trade/Trade.mqh>
CTrade trade;

struct CandleData {
   double open;
   double close;
   double high;
   double low;
   datetime time;
   bool isBullish;
};

//--- Global Variables
CandleData candleArray[4];
int candleCount = 0;
datetime lastCandleTime = 0;

input double RiskRewardRatio = 1.0;      // Take Profit = RRR × Risk
input double BreakEvenTrigger = 300;     // Move SL to BE after profit in points (e.g. 300 = 30 pips if 5-digit)
input double BreakEvenBuffer = 50; 
input int    trailingPoints = 600;      // Trailing Stop distance (points)
input int    initialSLPoints= 2000;        // Add small profit buffer (e.g. 50 = 5 pips)

//+------------------------------------------------------------------+
int OnInit()
{
   Print("EA Initialized - Candle Pattern Tracker Started ✅");
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
void OnTick()
{

 // Ensure every trade has a stop loss
   SetInitialStopLoss();

   // Manage trailing stop
   ApplyATRTrailingStop();
   
   
    datetime currentCandleTime = iTime(_Symbol, PERIOD_M1, 0);
    if(currentCandleTime == lastCandleTime)
        return;
   
    lastCandleTime = currentCandleTime;
    Print("🕒 New candle closed at ", TimeToString(currentCandleTime, TIME_DATE|TIME_SECONDS));

    // Get last closed candle (shift = 1)
    CandleData c;
    c.open  = iOpen(_Symbol, PERIOD_M1, 1);
    c.close = iClose(_Symbol, PERIOD_M1, 1);
    c.high  = iHigh(_Symbol, PERIOD_M1, 1);
    c.low   = iLow(_Symbol, PERIOD_M1, 1);
    c.time  = iTime(_Symbol, PERIOD_M1, 1);
    c.isBullish = (c.close > c.open);

    double upperWick = c.high - MathMax(c.open, c.close);
    double lowerWick = MathMin(c.open, c.close) - c.low;
    double body = MathAbs(c.close - c.open);

    PrintFormat("Candle Info: Time=%s | Bullish=%s | O=%.5f C=%.5f H=%.5f L=%.5f | UpperWick=%.5f LowerWick=%.5f Body=%.5f",
        TimeToString(c.time, TIME_DATE|TIME_SECONDS),
        c.isBullish ? "True" : "False",
        c.open, c.close, c.high, c.low,
        upperWick, lowerWick, body);

    // Check sequence and add
    if(CheckCandleSequence(c))
    {
        AddCandle(c);
    }
    else
    {
        Print("❌ Condition violated → Resetting array & storing violated candle");

        // If previous candle exists and same type as violated candle
        if(candleCount > 0 && candleArray[candleCount-1].isBullish == c.isBullish)
        {
            // Store previous candle and violated candle as first two
            CandleData prev = candleArray[candleCount-1];
            ResetCandleArray();
            candleArray[0] = prev;
            candleArray[1] = c;
            candleCount = 2;
            Print("🔁 Previous candle and violated candle are same type → Stored as first two candles");
        }
        else
        {
            // Only store violating candle as first
            ResetCandleArray();
            candleArray[0] = c;
            candleCount = 1;
            Print("🔁 Only violated candle stored as first candle");
        }
    }

    
}

//+------------------------------------------------------------------+
bool CheckCandleSequence(const CandleData &c)
{
   if(candleCount == 0) return true;
   if(candleCount == 1) return (c.isBullish == candleArray[0].isBullish);
   if(candleCount == 2) return (c.isBullish != candleArray[0].isBullish);
   if(candleCount == 3) return (c.isBullish == candleArray[2].isBullish);
   return false;
}

//+------------------------------------------------------------------+
void AddCandle(const CandleData &c)
{
   if(candleCount < 4)
   {
      candleArray[candleCount] = c;
      candleCount++;
      PrintFormat("✅ Candle stored in array [%d/4]", candleCount);
   }

   if(candleCount == 4)
   {
      Print("✅ Pattern complete! Displaying candles...");
      PrintPattern();

      // Check trade conditions
      CheckExtraConditionAndTrade();

      // After trade or failed condition → store 3rd & 4th as first two
      CandleData c3 = candleArray[2];
      CandleData c4 = candleArray[3];
      ResetCandleArray();
      candleArray[0] = c3;
      candleArray[1] = c4;
      candleCount = 2;
      Print("🔁 3rd & 4th candles stored as first two for next sequence");
   }
}

//+------------------------------------------------------------------+
void CheckExtraConditionAndTrade()
{
   double lotSize = 0.01;
   string symbol = _Symbol;
   int slippage = 5;
   double sl = 0;
   double tp = 0;
   double ask = SymbolInfoDouble(symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(symbol, SYMBOL_BID);

   // ---- Bullish Condition ----
   if(candleArray[3].isBullish)
   {
      // (1) Highest wick price among candle 1 and 2
      double high12 = MathMax(candleArray[0].high, candleArray[1].high);

      // (2) Highest body price among candle 3 and 4 (only open/close)
      double high34Body = MathMax(
         MathMax(candleArray[2].open, candleArray[2].close),
         MathMax(candleArray[3].open, candleArray[3].close)
      );

      if(high34Body > high12)
      {
         // (3) SL = Lowest wick among all 4
         sl = MathMin(
            MathMin(candleArray[0].low, candleArray[1].low),
            MathMin(candleArray[2].low, candleArray[3].low)
         );

         double risk = ask - sl;
         tp = ask + (risk * RiskRewardRatio);

         PrintFormat("📈 Bullish → BUY | Entry=%.3f | SL=%.3f | TP=%.3f | High12=%.3f | High34Body=%.3f",
                     ask, sl, tp, high12, high34Body);
         tradeBuy(symbol, lotSize, sl, tp, slippage);
      }
      else
      {
         PrintFormat("⚠️ Bullish not met | High34Body=%.3f ≤ High12=%.3f", high34Body, high12);
      }
   }
   // ---- Bearish Condition ----
   else
   {
      // (1) Lowest wick price among candle 1 and 2
      double low12 = MathMin(candleArray[0].low, candleArray[1].low);

      // (2) Lowest body price among candle 3 and 4 (only open/close)
      double low34Body = MathMin(
         MathMin(candleArray[2].open, candleArray[2].close),
         MathMin(candleArray[3].open, candleArray[3].close)
      );

      if(low34Body < low12)
      {
         // (3) SL = Highest wick among all 4
         sl = MathMax(
            MathMax(candleArray[0].high, candleArray[1].high),
            MathMax(candleArray[2].high, candleArray[3].high)
         );

         double risk = sl - bid;
         tp = bid - (risk * RiskRewardRatio);

         PrintFormat("📉 Bearish → SELL | Entry=%.3f | SL=%.3f | TP=%.3f | Low12=%.3f | Low34Body=%.3f",
                     bid, sl, tp, low12, low34Body);
         tradeSell(symbol, lotSize, sl, tp, slippage);
      }
      else
      {
         PrintFormat("⚠️ Bearish not met | Low34Body=%.3f ≥ Low12=%.3f", low34Body, low12);
      }
   }
}

//+------------------------------------------------------------------+
void PrintPattern()
{
   Print("---- STORED 4 CANDLES ----");
   for(int i=0; i<4; i++)
   {
      PrintFormat("#%d → Time=%s | %s | O=%.5f C=%.5f H=%.5f L=%.5f",
         i+1,
         TimeToString(candleArray[i].time, TIME_DATE|TIME_SECONDS),
         candleArray[i].isBullish ? "Bullish" : "Bearish",
         candleArray[i].open, candleArray[i].close,
         candleArray[i].high, candleArray[i].low);
   }
   Print("---------------------------");
}

//+------------------------------------------------------------------+
void ResetCandleArray()
{
   candleCount = 0;
   for(int i=0; i<4; i++)
   {
      candleArray[i].open = 0;
      candleArray[i].close = 0;
      candleArray[i].high = 0;
      candleArray[i].low = 0;
      candleArray[i].time = 0;
      candleArray[i].isBullish = false;
   }
   Print("🔁 Candle array cleared.");
}

//+------------------------------------------------------------------+
void tradeBuy(string symbol, double lot, double sl, double tp, int slippage)
{
   double price = SymbolInfoDouble(symbol, SYMBOL_ASK);
   MqlTradeRequest request;
   MqlTradeResult result;
   ZeroMemory(request); ZeroMemory(result);

   request.action    = TRADE_ACTION_DEAL;
   request.symbol    = symbol;
   request.volume    = lot;
   request.type      = ORDER_TYPE_BUY;
   request.price     = price;
   request.sl        = sl;
   request.tp        = tp;
   request.deviation = slippage;
   request.magic     = 123456;
   request.comment   = "CandleTrackerBuy";

   if(!OrderSend(request, result))
      Print("❌ BUY OrderSend failed: ", GetLastError());
   else
      Print("✅ BUY Order opened at ", price);
}

//+------------------------------------------------------------------+
void tradeSell(string symbol, double lot, double sl, double tp, int slippage)
{
   double price = SymbolInfoDouble(symbol, SYMBOL_BID);
   MqlTradeRequest request;
   MqlTradeResult result;
   ZeroMemory(request); ZeroMemory(result);

   request.action    = TRADE_ACTION_DEAL;
   request.symbol    = symbol;
   request.volume    = lot;
   request.type      = ORDER_TYPE_SELL;
   request.price     = price;
   request.sl        = sl;
   request.tp        = tp;
   request.deviation = slippage;
   request.magic     = 123456;
   request.comment   = "CandleTrackerSell";

   if(!OrderSend(request, result))
      Print("❌ SELL OrderSend failed: ", GetLastError());
   else
      Print("✅ SELL Order opened at ", price);
}

//+------------------------------------------------------------------+


//+------------------------------------------------------------------+
void tradeModify(ulong ticket, double sl, double tp)
{
   MqlTradeRequest request;
   MqlTradeResult result;
   ZeroMemory(request); ZeroMemory(result);

   request.action   = TRADE_ACTION_SLTP;
   request.position = ticket;
   request.sl       = sl;
   request.tp       = tp;

   if(!OrderSend(request, result))
      Print("❌ Order modification failed: ", GetLastError());
   else
      Print("✅ Order modified: SL=", sl, " TP=", tp);
}
