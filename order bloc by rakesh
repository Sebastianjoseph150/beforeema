//+------------------------------------------------------------------+
//| OnTick: main trading logic                                        |
//+------------------------------------------------------------------+
void OnTick()
{
    // Manage existing positions first
    ManagePositions();
    

    // New closed candle detection
    datetime t1 = (datetime)iTime(_Symbol, PERIOD_CURRENT, 1);
    if(t1 == lastBarTime) return;
    lastBarTime = t1;

    // Spread filter
    double ask = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
    double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);
    double spread = (ask - bid)/_Point;
    if(MaxSpreadPoints>0 && spread > MaxSpreadPoints) return;

    if(Bars(_Symbol, PERIOD_CURRENT) < 10) return;

    // Candle trend
    bool b4 = IsBull(4), b3 = IsBull(3), b2 = IsBull(2), b1 = IsBull(1);
    bool r4 = IsBear(4), r3 = IsBear(3), r2 = IsBear(2), r1 = IsBear(1);

    // --- First pattern: 2 bullish + 2 bearish -> SELL ---
    if(EnableSell && r2 && r1 && b4 && b3 && CandleEngulfs(1,2))
    {
        double execPrice = bid;
        double sl_price  = CandleHigh(2);
        double tp_price  = execPrice - (TP_points>0 ? TP_points*_Point : (sl_price-execPrice)*RiskReward);
        double lots      = UseRiskMoney ? LotFromRisk(RiskMoney, sl_price-execPrice) : FixedLots;
        lots = NormalizeLot(lots);
        PlaceOrder(false,lots,sl_price,tp_price);
    }

    // --- Second pattern: 2 bearish + 2 bullish -> BUY ---
    if(EnableBuy && b2 && b1 && r4 && r3 && CandleEngulfs(1,2))
    {
        double execPrice = ask;
        double sl_price  = CandleLow(2);
        double tp_price  = execPrice + (TP_points>0 ? TP_points*_Point : (execPrice-sl_price)*RiskReward);
        double lots      = UseRiskMoney ? LotFromRisk(RiskMoney, execPrice-sl_price) : FixedLots;
        lots = NormalizeLot(lots);
        PlaceOrder(true,lots,sl_price,tp_price);
    }

    // --- Third pattern: single candle engulfs previous two candles ---
    double high_23 = CombinedHigh(2,3);
    double low_23  = CombinedLow(2,3);

    if(EnableSell && r1 && CandleHigh(1)>=high_23 && CandleLow(1)<=low_23)
    {
        double execPrice = bid;
        double sl_price  = high_23;
        double tp_price  = execPrice - (TP_points>0 ? TP_points*_Point : (sl_price-execPrice)*RiskReward);
        double lots      = UseRiskMoney ? LotFromRisk(RiskMoney, sl_price-execPrice) : FixedLots;
        lots = NormalizeLot(lots);
        PlaceOrder(false,lots,sl_price,tp_price);
    }

    if(EnableBuy && b1 && CandleHigh(1)>=high_23 && CandleLow(1)<=low_23)
    {
        double execPrice = ask;
        double sl_price  = low_23;
        double tp_price  = execPrice + (TP_points>0 ? TP_points*_Point : (execPrice-sl_price)*RiskReward);
        double lots      = UseRiskMoney ? LotFromRisk(RiskMoney, execPrice-sl_price) : FixedLots;
        lots = NormalizeLot(lots);
        PlaceOrder(true,lots,sl_price,tp_price);
    }
    ApplyTrailingStop();
}
