//+------------------------------------------------------------------+
//| Apply ATR-based Trailing Stop                                   |
//+------------------------------------------------------------------+
void ApplyATRTrailingStop(double atrPeriod = 14, double atrMultiplier = 1.5)
{
   int total = PositionsTotal();
   if(total == 0)
      return;

   for(int i = total - 1; i >= 0; i--)
   {
      if(!PositionSelectByTicket(i)) continue;

      string sym = PositionGetString(POSITION_SYMBOL);
      ENUM_POSITION_TYPE type = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl        = PositionGetDouble(POSITION_SL);
      double tp        = PositionGetDouble(POSITION_TP);
      double bid       = SymbolInfoDouble(sym, SYMBOL_BID);
      double ask       = SymbolInfoDouble(sym, SYMBOL_ASK);

      // --- Calculate ATR value dynamically
      double atrValue[];
      if(CopyBuffer(iATR(sym, PERIOD_CURRENT, (int)atrPeriod), 0, 0, 1, atrValue) <= 0)
      {
         Print("⚠️ ATR data not available for ", sym);
         continue;
      }

      double atr = atrValue[0];
      double newSL;

      // --- BUY trailing
      if(type == POSITION_TYPE_BUY)
      {
         newSL = bid - (atr * atrMultiplier);

         if((sl == 0.0 || newSL > sl) && newSL > openPrice)
         {
            if(trade.PositionModify(sym, newSL, tp))
               PrintFormat("📈 ATR Trailing BUY | New SL=%.3f | ATR=%.3f", newSL, atr);
            else
               PrintFormat("❌ Failed to modify BUY SL | Err=%d", GetLastError());
         }
      }

      // --- SELL trailing
      if(type == POSITION_TYPE_SELL)
      {
         newSL = ask + (atr * atrMultiplier);

         if((sl == 0.0 || newSL < sl) && newSL < openPrice)
         {
            if(trade.PositionModify(sym, newSL, tp))
               PrintFormat("📉 ATR Trailing SELL | New SL=%.3f | ATR=%.3f", newSL, atr);
            else
               PrintFormat("❌ Failed to modify SELL SL | Err=%d", GetLastError());
         }
      }
   }
}

///stoploess////////////////
/////
///
void SetInitialStopLoss()
{
   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      string sym = PositionGetSymbol(i);
      if(!PositionSelect(sym)) continue;

      long   type = PositionGetInteger(POSITION_TYPE);
      double open = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl   = PositionGetDouble(POSITION_SL);
      double tp   = PositionGetDouble(POSITION_TP);

      // --- BUY ---
      if(type==POSITION_TYPE_BUY && sl==0.0)
      {
         double newSL = NormalizeDouble(open - initialSLPoints * _Point, _Digits);
         if(trade.PositionModify(sym,newSL,tp))
            Print("Initial SL set for BUY: ", DoubleToString(newSL,_Digits));
      }

      // --- SELL ---
      if(type==POSITION_TYPE_SELL && sl==0.0)
      {
         double newSL = NormalizeDouble(open + initialSLPoints * _Point, _Digits);
         if(trade.PositionModify(sym,newSL,tp))
            Print("Initial SL set for SELL: ", DoubleToString(newSL,_Digits));
      }
   }
}
